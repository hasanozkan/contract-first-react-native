{
  "name": "contract-first-react-native",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^10.11.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~30.5.2",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "^7.13.0",
    "react-test-renderer": "^19.3.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "contracts": "bash scripts/contracts.sh",
    "contracts:check": "bash scripts/contracts.sh --check",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check": "npm run lint && npm run typecheck && npm test -- --ci && npm run contracts:check",
    "test:live": "LIVE=1 jest --config jest.live.config.js --no-cache"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "live\\.test\\.ts$"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 20000
  }
}
